{
  "name": "tsunami",
  "version": "1.0.1",
  "description": "A quiet UI framework.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "sass --watch --no-source-map src/index.scss dist/tsunami.css",
    "build": "bun scripts/build.ts",
    "lint": "eslint src/js",
    "check:docs": "bun site/scripts/check-docs.ts",
    "check:a11y": "bun scripts/check-a11y.ts",
    "check:types": "tsc -p types/tsconfig.json",
    "test": "bun test scripts",
    "test:e2e": "playwright test",
    "size": "bun scripts/size.ts",
    "docs": "cd site && bun install --frozen-lockfile && bun run dev",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "sass": "1.106.1",
    "typescript": "7.0.2"
  }
}
