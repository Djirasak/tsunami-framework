{
  "name": "@djirasak/tsunami-ui",
  "version": "1.1.2",
  "description": "A quiet UI framework.",
  "keywords": [
    "ui",
    "css",
    "framework",
    "components",
    "semantic-html",
    "data-attributes",
    "vanilla-js",
    "dark-mode",
    "accessibility"
  ],
  "homepage": "https://tsunami.zercoms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Djirasak/tsunami-framework.git"
  },
  "bugs": {
    "url": "https://github.com/Djirasak/tsunami-framework/issues"
  },
  "license": "MIT",
  "type": "module",
  "style": "./dist/tsunami.min.css",
  "main": "./dist/tsunami.min.js",
  "module": "./dist/tsunami.min.js",
  "types": "./dist/tsunami.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/tsunami.d.ts",
      "default": "./dist/tsunami.min.js"
    },
    "./css": "./dist/tsunami.min.css",
    "./js": "./dist/tsunami.min.js",
    "./dist/*": "./dist/*",
    "./fonts/*": "./fonts/*",
    "./flags/*": "./flags/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "flags",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "sass --watch --no-source-map src/index.scss dist/tsunami.css",
    "build": "bun scripts/build.ts",
    "lint": "eslint src/js",
    "check:docs": "bun site/scripts/check-docs.ts",
    "check:a11y": "bun scripts/check-a11y.ts",
    "check:types": "tsc -p types/tsconfig.json",
    "test": "bun test scripts",
    "test:e2e": "playwright test",
    "size": "bun scripts/size.ts",
    "docs": "cd site && bun install --frozen-lockfile && bun run dev",
    "audit": "bun audit --audit-level=high",
    "prepublishOnly": "bun scripts/check-publish.ts && bun run build && bun run check:types && bun run size"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "sass": "1.106.1",
    "typescript": "7.0.2"
  }
}
