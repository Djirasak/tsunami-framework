{
  "name": "tsunami",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "sass --watch --no-source-map src/index.scss dist/tsunami.css",
    "build": "bun scripts/build.ts",
    "lint": "eslint src/js",
    "docs": "cd site && bun install --frozen-lockfile && bun run dev",
    "audit": "bun audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "sass": "1.106.1"
  }
}
